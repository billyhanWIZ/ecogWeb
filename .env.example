# 운영: /opt/ecog/.env 로 복사해서 채운다 (git 에 올리지 않음)
NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# 기존 restapi 와 같은 DB (예: smartgym). 전용 계정을 만들어 쓴다.
# 테이블 단위 GRANT 는 테이블이 있어야 하므로 README 의 '빈 테이블 먼저 만들기'를 먼저 실행할 것.
# CREATE USER 'ecog'@'localhost' IDENTIFIED BY '비밀번호';
# GRANT SELECT ON smartgym.eg_cleancount TO 'ecog'@'localhost';
# GRANT SELECT, UPDATE (mangegroup) ON smartgym.eg_deviceinfo TO 'ecog'@'localhost';
# GRANT SELECT ON smartgym.eg_managegroup TO 'ecog'@'localhost';
# GRANT SELECT ON smartgym.eg_userinfo TO 'ecog'@'localhost';
# GRANT CREATE, INDEX, ALTER ON smartgym.* TO 'ecog'@'localhost';
# GRANT SELECT, INSERT, UPDATE, DELETE ON smartgym.eg_org TO 'ecog'@'localhost';   (eg_device_site, eg_user, eg_setting,
#   eg_report, eg_audit_log, eg_schema_migrations 도 같은 방식)
# 이후 sql/NNN 으로 새 테이블을 추가하면 그 테이블에도 같은 GRANT 가 필요하다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ecog
DB_PASSWORD=
DB_NAME=smartgym

# setup.sh 가 자동으로 만든다
SESSION_SECRET=

# 로고 파일 저장 위치 (기본: 앱 폴더/data)
# DATA_DIR=/opt/ecog/data
