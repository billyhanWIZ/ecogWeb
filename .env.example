# 운영: /opt/ecog/.env 로 복사해서 채운다 (git 에 올리지 않음)
NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# 기존 restapi 와 같은 DB (예: smartgym). 전용 계정을 만들어 쓰는 것을 권장
# GRANT SELECT ON smartgym.eg_cleancount TO 'ecog'@'localhost';
# GRANT SELECT, UPDATE (mangegroup) ON smartgym.eg_deviceinfo TO 'ecog'@'localhost';
# GRANT SELECT ON smartgym.eg_managegroup TO 'ecog'@'localhost';
# GRANT SELECT ON smartgym.eg_userinfo TO 'ecog'@'localhost';
# 새 테이블(eg_org, eg_device_site, eg_user, eg_setting, eg_report, eg_audit_log, eg_schema_migrations)은
# 처음 한 번 CREATE 권한이 필요하다. 가장 간단히는 GRANT ALL ON smartgym.eg_% 대신 아래처럼:
# GRANT CREATE, SELECT, INSERT, UPDATE, DELETE, INDEX, ALTER ON smartgym.* TO 'ecog'@'localhost';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ecog
DB_PASSWORD=
DB_NAME=smartgym

# setup.sh 가 자동으로 만든다
SESSION_SECRET=

# 로고 파일 저장 위치 (기본: 앱 폴더/data)
# DATA_DIR=/opt/ecog/data
