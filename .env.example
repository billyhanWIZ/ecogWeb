# 운영: /opt/ecog/.env 로 복사해서 채운다 (git 에 올리지 않음)
NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# 기존 restapi 와 같은 DB (예: smartgym). 전용 계정을 만들어 쓴다.
# 테이블 단위 GRANT 는 테이블이 있어야 하므로 README 의 '빈 테이블 먼저 만들기'를 먼저 실행할 것.
# CREATE USER 'ecog'@'localhost' IDENTIFIED BY '비밀번호';
# GRANT SELECT, INSERT, UPDATE ON smartgym.eg_cleancount TO 'ecog'@'localhost';   (새 태블릿의 세척 기록)
# GRANT SELECT, INSERT, UPDATE ON smartgym.eg_deviceinfo TO 'ecog'@'localhost';   (배정 동기화·새 장비·태블릿 신호)
# GRANT SELECT ON smartgym.eg_managegroup TO 'ecog'@'localhost';
# GRANT SELECT ON smartgym.eg_userinfo TO 'ecog'@'localhost';
# GRANT CREATE, INDEX, ALTER ON smartgym.* TO 'ecog'@'localhost';
# GRANT SELECT, INSERT, UPDATE, DELETE ON smartgym.eg_org TO 'ecog'@'localhost';   (eg_device_site, eg_user, eg_setting,
#   eg_report, eg_audit_log, eg_schema_migrations, eg_device_hidden, eg_device_test,
#   eg_tablet, eg_clean_event 도 같은 방식)
# 이후 sql/NNN 으로 새 테이블을 추가하면 그 테이블에도 같은 GRANT 가 필요하다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ecog
DB_PASSWORD=
DB_NAME=smartgym

# setup.sh 가 자동으로 만든다
SESSION_SECRET=

# 대시보드·TV 화면 날씨 (선택). 둘 중 하나만 넣는다. 둘 다 비우면 날씨를 표시하지 않는다.
#  - 기상청 API허브(apihub.kma.go.kr) 예특보 > 단기예보 > '동네예보(초단기실황·초단기예보·단기예보) 조회' 활용신청 후 인증키
KMA_APIHUB_KEY=
#  - 또는 공공데이터포털 '기상청_단기예보 ((구)_동네예보) 조회서비스' 일반 인증키(Decoding)
KMA_SERVICE_KEY=

# 로고 파일 저장 위치 (기본: 앱 폴더/data)
# DATA_DIR=/opt/ecog/data
